generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------
// Users
// ----------------------

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}


// ----------------------
// Products
// ----------------------

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  price     Float
  code      String   @unique
  stock     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}